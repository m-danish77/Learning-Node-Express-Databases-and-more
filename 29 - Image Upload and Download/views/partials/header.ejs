<header class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-black text-indigo-600 tracking-tighter hover:opacity-80 transition-opacity">
          AirBnB
        </a>
      </div>

      <nav class="flex items-center gap-x-2">
        <% if(isLoggedIn) { %>
          <% if(user && user.userType === 'guest') { %>
            <a href="/home-list"
              class="px-3 py-2 rounded-lg text-sm font-semibold transition-all duration-200 <%= pageTitle === 'Home List' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 hover:bg-gray-100' %>">
              Home List
            </a>

            <a href="/favourite-list"
              class="px-3 py-2 rounded-lg text-sm font-semibold transition-all duration-200 <%= pageTitle === 'Favourites List' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 hover:bg-gray-100' %>">
              Favourites
            </a>

            <a href="/bookings"
              class="px-3 py-2 rounded-lg text-sm font-semibold transition-all duration-200 <%= pageTitle === 'Bookings' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 hover:bg-gray-100' %>">
              Bookings
            </a>

            <div class="h-6 w-px bg-gray-200 mx-1"></div>
          <% }else { %>
            <a href="/host/host-home-list"
              class="px-3 py-2 rounded-lg text-sm font-semibold transition-all duration-200 <%= pageTitle === 'Host Home List' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 hover:bg-gray-100' %>">
              Host List
            </a>

            <a href="/host/add-home"
              class="px-3 py-2 rounded-lg text-sm font-semibold transition-all duration-200 <%= pageTitle === 'Form Page' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 hover:bg-gray-100' %>">
              Add Home
            </a>
          <% } %>
          <form action="/logout" method="post" class="inline">
            <button type="submit"
              class="px-3 py-2 rounded-lg text-sm font-bold transition-all duration-200 text-red-600 hover:bg-red-50">
              Logout
            </button>
          </form>

        <% } else { %>
          <a href="/login"
            class="px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 <%= pageTitle === 'Login Page' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 hover:bg-gray-100' %>">
            Login
          </a>

          <a href="/signup"
            class="px-5 py-2 rounded-lg text-sm font-bold transition-all duration-200 outline-none
            <%= pageTitle === 'SignUp Page' ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-600 hover:bg-gray-100' %>">
            Sign Up
          </a>
        <% } %>
      </nav>

    </div>
  </div>
</header>
