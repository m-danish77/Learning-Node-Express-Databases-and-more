<%- include('../partials/head.ejs') %>
  <body class="bg-gray-50 font-sans antialiased text-gray-900">
    <%- include('../partials/header.ejs') %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="max-w-md mx-auto mb-8 text-center">
        <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">
          <%= editing ? "Edit" : "Host" %> Your Home
        </h2>
        <p class="mt-2 text-gray-500">
          <%= editing ? "Update the details below to update your property on AirbnB." : "Fill out the details below to list your property on AirbnB." %>
        </p>
      </div>

      <form
        action="/host/<%= editing ? "edit-home" : "add-home" %>"
        method="post"
        <%# below attribute is essential whenever you are building a form that allows users to upload files %>
        enctype="multipart/form-data"
        class="max-w-md mx-auto p-8 bg-white rounded-2xl border border-gray-200 shadow-xl"
      >
        <div class="mb-6">
          <input type="hidden" name="id" value="<%= editing ? home._id : "" %>">
          <label
            for="house-name"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Property Name
          </label>
          <input
            type="text"
            name="house-name"
            id="house-name"
            <%# // This is .ejs file commit syntax. I am prefilling details for the editing page %>
            value="<%= editing ? home.houseName : "" %>"
            placeholder="e.g. Cozy Beachfront Villa"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="price-per-night"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Price Per Night
          </label>
          <input
            type="text"
            name="price-per-night"
            id="price-per-night"
            value="<%= editing ? home.pricePerNight : "" %>"
            placeholder="e.g. 200$ to 500$"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="location"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Location
          </label>
          <input
            type="text"
            name="location"
            id="location"
            value="<%= editing ? home.location : "" %>"
            placeholder="e.g. House No. Street, City, Country"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="rating"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Rating
          </label>
          <input
            type="text"
            name="rating"
            id="rating"
            value="<%= editing ? home.rating : "" %>"
            placeholder="e.g. 1 to 5"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label for="picture" class="block text-sm font-semibold text-gray-700 mb-2">
            Upload Picture
          </label>
          <input
            type="file"
            name="picture"
            id="picture"

            accept="image/jpg, image/jpeg, image/png"

            class="block w-full text-sm text-gray-500
              file:mr-4 file:py-2.5 file:px-4
              file:rounded-xl file:border-0
              file:text-sm file:font-semibold
              file:bg-indigo-50 file:text-indigo-700
              hover:file:bg-indigo-100
              border border-gray-300 rounded-xl cursor-pointer focus:outline-none"
          />
        </div>

        <div class="mb-6">
          <label for="rules" class="block text-sm font-semibold text-gray-700 mb-2">
            Upload Home Rules Pdf
          </label>
          <input
            type="file"
            name="rules"
            id="rules"

            accept="application/pdf"

            class="block w-full text-sm text-gray-500
              file:mr-4 file:py-2.5 file:px-4
              file:rounded-xl file:border-0
              file:text-sm file:font-semibold
              file:bg-indigo-50 file:text-indigo-700
              hover:file:bg-indigo-100
              border border-gray-300 rounded-xl cursor-pointer focus:outline-none"
          />
        </div>


        <textarea
          name="description"
          rows="5"
          cols="80"
          placeholder="Enter Description Here"
          class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
          required><%= editing ? home.description : "" %></textarea>

        <button
          type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 px-4 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 active:scale-[0.98]"
        >
          <%= editing ? "Update Listing" : "Publish Listing"%>
        </button>

        <p class="mt-4 text-center text-xs text-gray-400">
          <%= editing ? "" : "By clicking \"Publish\", you agree to our hosting terms."%>
        </p>
      </form>
    </main>
  </body>
</html>
