<%- include('../partials/head.ejs') %>
  <body class="bg-gray-50 font-sans antialiased text-gray-900">
    <%- include('../partials/header.ejs') %>

    <main
      class="min-h-[calc(100vh-64px)] flex items-center justify-center px-4 py-12"
    >
      <div
        class="max-w-md w-full bg-white rounded-2xl shadow-xl p-8 text-center border border-gray-100 animate-in fade-in zoom-in duration-500"
      >
        <div
          class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 mb-6"
        >
          <svg
            class="h-10 w-10 text-green-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            ></path>
          </svg>
        </div>

        <h1 class="text-3xl font-extrabold text-gray-900 mb-2 tracking-tight">
          Success!
        </h1>
        <p class="text-gray-500 mb-10 leading-relaxed">
          Your property has been listed successfully. It is now visible to
          millions of travelers worldwide.
        </p>

        <div class="flex flex-col gap-3">
          <a
            href="/"
            class="w-full bg-indigo-600 text-white font-semibold py-3.5 px-4 rounded-xl hover:bg-indigo-700 transition duration-200 shadow-md"
          >
            Go to Homepage
          </a>
          <a
            href="/host/add-home"
            class="w-full bg-white text-gray-700 font-semibold py-3.5 px-4 rounded-xl border border-gray-200 hover:bg-gray-50 transition duration-200"
          >
            List Another Property
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
