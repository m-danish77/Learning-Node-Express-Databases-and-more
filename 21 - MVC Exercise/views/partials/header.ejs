<header class="bg-white border-b border-gray-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-center h-16 relative">

      <div class="absolute left-0 flex-shrink-0 flex items-center">
        <span class="text-2xl font-bold text-indigo-600 tracking-tight">AirBnB</span>
      </div>

      <nav class="flex space-x-4">
        <a
          href="/"
          class="px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 outline-none <%= pageTitle === 'Airbnb Main Page' ? 'bg-indigo-100 text-indigo-700 ring-4 ring-yellow-400' : 'text-gray-600 hover:text-indigo-600 hover:bg-indigo-50' %>"
        >
          Home
        </a>

        <a
          href="/home-list"
          class="px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 outline-none <%= pageTitle === 'Home List' ? 'bg-indigo-600 text-white ring-4 ring-yellow-400 shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>"
        >
          Home List
        </a>

        <a
          href="/fovourite-list"
          class="px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 outline-none <%= pageTitle === 'Favourites List' ? 'bg-indigo-600 text-white ring-4 ring-yellow-400 shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>"
        >
          Favourites
        </a>

        <a
          href="/bookings"
          class="px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 outline-none <%= pageTitle === 'Bookings' ? 'bg-indigo-600 text-white ring-4 ring-yellow-400 shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>"
        >
          Bookings
        </a>

        <%# Host Files Started %>

        <a
          href="/host/host-home-list"
          class="px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 outline-none <%= pageTitle === 'Host Home List' ? 'bg-indigo-600 text-white ring-4 ring-yellow-400 shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>"
        >
          Host Home List
        </a>

        <a
          href="/host/add-home"
          class="px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 outline-none <%= pageTitle === 'Form Page' ? 'bg-indigo-600 text-white ring-4 ring-yellow-400 shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>"
        >
          Add Home
        </a>
      </nav>
    </div>
  </div>
</header>
