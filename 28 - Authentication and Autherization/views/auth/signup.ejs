<%- include('../partials/head.ejs') %>
<body class="bg-gray-50 font-sans antialiased text-gray-900">
  <%- include('../partials/header.ejs') %>

  <main class="min-h-[90vh] flex items-center justify-center px-4 py-8">
    <div class="max-w-md w-full space-y-4 bg-white p-8 rounded-2xl shadow-xl border border-gray-100">

      <div class="text-center">
        <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight">
          Create your account
        </h1>
        <p class="mt-1 text-xs text-gray-500">
          Please enter your details to register
        </p>
      </div>

      <form action="/signup" method="POST" class="mt-4 space-y-4">
        <div class="space-y-3">

          <% if (errors.length > 0) { %>
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-4">
              <ul class="list-disc ml-5">
                <% errors.forEach(error => { %>
                  <li class="text-sm text-red-700"><%= error %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="fname" class="block text-xs font-semibold text-gray-700 mb-1">First Name</label>
              <input id="fname" name="fname" value="<%= oldInput.fname ? oldInput.fname : ''%>" type="text" required
                class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 text-sm"
                placeholder="Muhammad">
            </div>
            <div>
              <label for="lname" class="block text-xs font-semibold text-gray-700 mb-1">Last Name</label>
              <input id="lname" name="lname" value="<%= oldInput.lname ? oldInput.lname : ''%>" type="text" required
                class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 text-sm"
                placeholder="Danish">
            </div>
          </div>

          <div>
            <label for="email" class="block text-xs font-semibold text-gray-700 mb-1">Email Address</label>
            <input id="email" name="email" value="<%= oldInput.email ? oldInput.email : ''%>" type="email" required
              class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 text-sm"
              placeholder="danish@example.com">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="password" class="block text-xs font-semibold text-gray-700 mb-1">Password</label>
              <input id="password" name="password" type="password" required
                class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 text-sm"
                placeholder="••••••••">
            </div>
            <div>
              <label for="cPassword" class="block text-xs font-semibold text-gray-700 mb-1">Confirm</label>
              <input id="cPassword" name="cPassword" type="password" required
                class="appearance-none block w-full px-3 py-2 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-200 text-sm"
                placeholder="••••••••">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-2">Register as a:</label>
            <div class="flex items-center space-x-6">
              <label class="flex items-center cursor-pointer group">
                <input type="radio" name="userType" value="guest" <%= (oldInput.userType === 'guest' || oldInput.userType === '') ? 'checked' : '' %>
                  class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 cursor-pointer">
                <span class="ml-2 text-sm text-gray-600 group-hover:text-indigo-600 transition-colors">Guest</span>
              </label>
              <label class="flex items-center cursor-pointer group">
                <input type="radio" name="userType" <%= oldInput.userType === "host" ? "checked" : ""%> value="host"
                  class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 cursor-pointer">
                <span class="ml-2 text-sm text-gray-600 group-hover:text-indigo-600 transition-colors">Host</span>
              </label>
            </div>
          </div>

          <div class="flex items-center pt-2">
            <input id="terms" name="terms" <%= oldInput.terms ? 'checked' : '' %>  type="checkbox" required
              class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer">
            <label for="terms" class="ml-2 block text-xs text-gray-600 cursor-pointer">
              I agree to the Terms & Conditions
            </label>
          </div>

        </div>

        <div>
          <button type="submit"
            class="w-full flex justify-center py-2.5 px-4 border border-transparent text-sm font-bold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200 shadow-lg shadow-indigo-100">
            Register Account
          </button>
        </div>
      </form>

      <p class="text-center text-xs text-gray-500">
        Already have an account?
        <a href="/login" class="font-bold text-indigo-600 hover:text-indigo-500">Log in here</a>
      </p>
    </div>
  </main>

</body>
</html>
