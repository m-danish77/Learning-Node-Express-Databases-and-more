db.cars.find(
  {"features": {$all: ["Sunroof", "Wireless Charging"]}}
)

db.cars.find({
  $and: [
    {"fuel_type": "Electric"},
    {"engine.type": "Electric Motor"},
    {"sunroof": true},
  ]
})


db.cars.aggregate([
  {$match: {
    maker: "Hyundai",
    "engine.cc": {$gt: 1200}
  }},
  {$count: "total_cars"}
])

db.cars.aggregate([
  {$match: { maker: "Hyundai",}},
  {$project: {_id: 0, maker: 1, model: 1}},
  {$sort: {model: 1}}
])


db.cars.aggregate([
  {$match: { model: "Creta"}},
  {$unwind: "$owners"}
])

db.cars.aggregate([
  {

  $addFields:
  {
    priceInLakhs: {

    $concat: [{
      $toString: {
      $round: [{
        $divide: ["$price", 90000]
        }, 2]
      }, " ", "lacs"]
    }

    }
  }

  },

  {
  $project: { _id: 0, maker: 1, model:1, priceInLakhs: 1}
  },
])


db.cars.aggregate([
  {$match: {maker: "Hyundai"}},
  {$set: {totalServiceCost: {$sum: "$service_history.cost"}}},
  {$project: {_id: 0, maker: 1, model: 1, totalServiceCost: 1} }
])


db.cars.aggregate([
  {$match: {maker: "Hyundai"}},
  {$set: {totalServiceCost: {$sum: {"$service_history.cost"}}}},
  {$project: {_id:0, model: 1, maker: 1, totalServiceCost: 1}}
])


db.cars.aggregate([
  {$set: {    carType: {
    $switch: {
      branches: [
        {case: {$eq: ["$fuel_type", "Diesel"]}, then: "Petrol Car"}
      ],
      default: "Non Petrol Car"
    }
  }}},
  {$project: {
    _id: 0, maker:1, model:1, carType: 1
  }}
])


db.cars.aggregate([
  {$set: {    carCategory: {
    $switch: {
      branches: [
        {case: {$lt: ["$price", 500000]}, then: "Budget"},
        {case: {$and: [{$gte: ["$price", 500000]}, {$lt: ["$price", 1000000]}]}, then: "Midrange"}
      ],
      default: "Premium"
    }
  }}},
  {$project: {
    _id: 0, maker:1, model:1, carCategory: 1
  }}
])


db.users.aggregate([
  {$lookup: {
    from: "orders",
    localField: "_id",
    foreignField: "user_id",
    as: "orders"
  }}
])
