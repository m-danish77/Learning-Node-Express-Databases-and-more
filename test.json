db.cars.aggregate([
  {$match: {maker: "Hyundai"}},
  {$project: {_id: 0, CarName: {$toUpper: {$concat: ["$maker", " ", "$model"]}}}},
  {$out: "Hyundai_Cars"}
])


db.cars.aggregate([
  {$project: { _id:0, maker:1, model: 1,
  fuel_category: {
    $cond: {
      if: { $eq: ["$fuel_type", "Petrol"]},
        then: "Petrol_Cars",
        else: "Non_Petrol_Cars"
    }
  }
  }},
])


db.users.aggregate([
  {$lookup: {
    from: "orders",
    localField: "_id",
    foreignField: "user_id",
    as: "orders"
  }}
])




