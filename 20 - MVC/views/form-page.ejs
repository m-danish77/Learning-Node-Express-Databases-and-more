<%- include('partials/head.ejs') %>
  <body class="bg-gray-50 font-sans antialiased text-gray-900">
    <%- include('partials/header.ejs') %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="max-w-md mx-auto mb-8 text-center">
        <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">
          Host Your Home
        </h2>
        <p class="mt-2 text-gray-500">
          Fill out the details below to list your property on AirbnB.
        </p>
      </div>

      <form
        action="/host/add-home"
        method="post"
        class="max-w-md mx-auto p-8 bg-white rounded-2xl border border-gray-200 shadow-xl"
      >
        <div class="mb-6">
          <label
            for="house-name"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Property Name
          </label>
          <input
            type="text"
            name="house-name"
            id="house-name"
            placeholder="e.g. Cozy Beachfront Villa"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="price-per-night"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Price Per Night
          </label>
          <input
            type="text"
            name="price-per-night"
            id="price-per-night"
            placeholder="e.g. 200$ to 500$"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="location"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Location
          </label>
          <input
            type="text"
            name="location"
            id="location"
            placeholder="e.g. House No. Street, City, Country"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="rating"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Rating
          </label>
          <input
            type="text"
            name="rating"
            id="rating"
            placeholder="e.g. 1 to 5"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <div class="mb-6">
          <label
            for="picture-url"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Picture Url
          </label>
          <input
            type="text"
            name="picture-url"
            id="picture-url"
            placeholder="e.g. https://example.com/image.jpg"
            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 outline-none placeholder:text-gray-400"
            required
          />
        </div>

        <button
          type="submit"
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 px-4 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 active:scale-[0.98]"
        >
          Publish Listing
        </button>

        <p class="mt-4 text-center text-xs text-gray-400">
          By clicking "Publish", you agree to our hosting terms.
        </p>
      </form>
    </main>
  </body>
</html>
