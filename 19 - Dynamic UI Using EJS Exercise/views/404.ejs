<%- include('partials/head.ejs') %>
  <body class="bg-gray-50 font-sans antialiased text-gray-900">
    <%- include('partials/header.ejs') %>

    <main
      class="min-h-[calc(100vh-64px)] flex items-center justify-center px-6 py-24 sm:py-32 lg:px-8"
    >
      <div class="text-center">
        <p class="text-6xl font-black text-indigo-600">404</p>

        <h1
          class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl"
        >
          Page not found
        </h1>
        <p class="mt-6 text-lg leading-7 text-gray-600">
          Sorry, we couldn’t find the page you’re looking for. It might have
          been moved or deleted.
        </p>

        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a
            href="/"
            class="rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200"
          >
            Go back home
          </a>
          <a
            href="#"
            class="text-sm font-semibold text-gray-900 hover:text-indigo-600 transition-colors duration-200"
          >
            Contact support <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </main>

    <footer
      class="fixed bottom-0 w-full py-6 text-center text-sm text-gray-400"
    >
      &copy; 2026 AirBnb Clone. All rights reserved.
    </footer>
  </body>
</html>
